{% block scripts %}
<script>
/* ── Formázó segédfüggvények ── */
function formatAmountDisplay(el) {
    const raw = parseFloat(el.value.replace(/\s/g, '').replace(',', '.'));
    if (!isNaN(raw) && raw >= 0) el.value = Math.round(raw).toLocaleString('hu-HU').replace(/,/g, ' ');
}
function unformatAmount(el) {
    el.value = el.value.replace(/\s/g, '');
}
function getFieldAmount(id) {
    return parseFloat(document.getElementById(id).value.replace(/\s/g, '').replace(',', '.')) || 0;
}
function fmtFull(value, sym) {
    const rounded = Math.round(value);
    const formatted = Math.abs(rounded).toLocaleString('hu-HU').replace(/,/g, ' ');
    const prefix = rounded < 0 ? '-' : '';
    return sym === 'Ft' ? prefix + formatted + ' Ft' : prefix + sym + ' ' + formatted;
}
function fmtShort(value, sym) {
    const abs = Math.abs(value);
    const sign = value < 0 ? '-' : '';
    let s;
    if (abs >= 1e9)      s = (abs / 1e9).toFixed(1) + ' Mrd';
    else if (abs >= 1e6) s = (abs / 1e6).toFixed(2) + ' M';
    else if (abs >= 1e3) s = (abs / 1e3).toFixed(1) + ' E';
    else                 s = Math.round(abs).toString();
    return sym === 'Ft' ? sign + s + ' Ft' : sign + sym + ' ' + s;
}
function pct(v) { return v.toFixed(2) + '%'; }
function setText(id, text) { document.getElementById(id).textContent = text; }

/* ── Forgatókönyv színek ── */
const SCENARIO_COLORS = [
    { solid: '#2563eb', light: 'rgba(37,99,235,0.50)',  faint: 'rgba(37,99,235,0.25)',  area: 'rgba(37,99,235,0.08)' },
    { solid: '#16a34a', light: 'rgba(22,163,74,0.50)',  faint: 'rgba(22,163,74,0.25)',  area: 'rgba(22,163,74,0.08)'  },
    { solid: '#ea580c', light: 'rgba(234,88,12,0.50)',  faint: 'rgba(234,88,12,0.25)',  area: 'rgba(234,88,12,0.08)'  },
];
const SCENARIO_LABELS = ['A', 'B', 'C'];

/* ── Forgatókönyv állapot ── */
const DEFAULT_SCENARIO = {
    currency: 'Ft', startAmount: 0, monthlyContrib: 30000, years: 20,
    stockPct: 50, bondYield: 6.5, stockYield: 8.0,
    expenseRatio: 0.5, contribGrowth: 0, inflationRate: 4.5,
};
let scenarios     = [{ ...DEFAULT_SCENARIO, name: 'A forgatókönyv' }];
let scenarioCount = 1;
let activeScenario = 0;

/* ── Előbeállítások ── */
const PRESETS = {
    hu: { currency: 'Ft', startAmount: 0, monthlyContrib: 30000, years: 20,
          bondYield: 6.5, stockYield: 8.0, bondPct: 50, expenseRatio: 0.5,
          contribGrowth: 0, inflationRate: 4.5 },
    eu: { currency: '€',  startAmount: 0, monthlyContrib: 300,   years: 20,
          bondYield: 3.0, stockYield: 8.0, bondPct: 50, expenseRatio: 0.5,
          contribGrowth: 0, inflationRate: 2.3 },
};

let chartInstance = null;
let activePreset  = 'hu';
let tbszMode      = false;
let chartMode     = 'portfolio';

function setAccountType(type) {
    tbszMode = (type === 'tbsz');
    document.getElementById('btn-regular').classList.toggle('active', !tbszMode);
    document.getElementById('btn-tbsz').classList.toggle('active',  tbszMode);
    if (document.getElementById('results').classList.contains('visible')) calculate();
}

function setChartMode(mode) {
    chartMode = mode;
    document.getElementById('mode-portfolio').classList.toggle('active', mode === 'portfolio');
    document.getElementById('mode-breakdown').classList.toggle('active', mode === 'breakdown');
    if (document.getElementById('results').classList.contains('visible')) calculate();
}

/* ── Forgatókönyv mentése / betöltése ── */
function saveCurrentScenario() {
    const spct = parseInt(document.getElementById('stockPct').value) || 50;
    scenarios[activeScenario] = {
        name:          scenarios[activeScenario].name,
        currency:      document.getElementById('currency').value,
        startAmount:   getFieldAmount('startAmount'),
        monthlyContrib:getFieldAmount('monthlyContrib'),
        years:         parseInt(document.getElementById('years').value)          || 20,
        stockPct:      spct,
        bondYield:     parseFloat(document.getElementById('bondYield').value)    || 0,
        stockYield:    parseFloat(document.getElementById('stockYield').value)   || 0,
        expenseRatio:  parseFloat(document.getElementById('expenseRatio').value) || 0,
        contribGrowth: parseFloat(document.getElementById('contribGrowth').value)|| 0,
        inflationRate: parseFloat(document.getElementById('inflationRate').value)|| 0,
    };
}

function loadScenarioToDOM(idx) {
    const s = scenarios[idx];
    document.getElementById('currency').value = s.currency;
    document.getElementById('startAmount').value = s.startAmount === 0 ? '0' :
        Math.round(s.startAmount).toLocaleString('hu-HU').replace(/,/g, ' ');
    document.getElementById('monthlyContrib').value =
        Math.round(s.monthlyContrib).toLocaleString('hu-HU').replace(/,/g, ' ');
    document.getElementById('years').value          = s.years;
    document.getElementById('stockPct').value       = s.stockPct;
    document.getElementById('bondYield').value      = s.bondYield;
    document.getElementById('stockYield').value     = s.stockYield;
    document.getElementById('expenseRatio').value   = s.expenseRatio;
    document.getElementById('contribGrowth').value  = s.contribGrowth;
    document.getElementById('inflationRate').value  = s.inflationRate;
    document.getElementById('contrib-unit').textContent = s.currency + ' / hó';
    updateSliderGradient(s.stockPct);
    updateSliderLabels(s.stockPct);
    updateBlendedReturn();
}

/* ── Forgatókönyv fül kezelés ── */
function switchScenario(idx) {
    saveCurrentScenario();
    activeScenario = idx;
    document.querySelectorAll('.scenario-tab').forEach((tab, i) =>
        tab.classList.toggle('active', i === idx));
    loadScenarioToDOM(idx);
    if (document.getElementById('results').classList.contains('visible')) calculate();
}

function addScenario() {
    if (scenarioCount >= 3) return;
    saveCurrentScenario();
    const newIdx = scenarioCount;
    scenarios[newIdx] = {
        ...scenarios[activeScenario],
        name: SCENARIO_LABELS[newIdx] + ' forgatókönyv',
    };
    scenarioCount++;

    // Új fül beillesztése a "+ Hozzáadás" gomb elé
    const bar = document.getElementById('scenario-bar');
    const addBtn = document.getElementById('add-scenario-btn');
    const color = SCENARIO_COLORS[newIdx].solid;
    const tab = document.createElement('button');
    tab.className = 'scenario-tab';
    tab.id = 'tab-' + newIdx;
    tab.innerHTML = `<span class="tab-dot" style="background:${color}"></span> ${SCENARIO_LABELS[newIdx]} forgatókönyv`;
    tab.onclick = () => switchScenario(newIdx);
    bar.insertBefore(tab, addBtn);

    if (scenarioCount >= 3) addBtn.style.display = 'none';
    switchScenario(newIdx);
}

/* ── Előbeállítás betöltése ── */
function loadPreset(key, btn) {
    activePreset = key;
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const p = PRESETS[key];
    const stockPct = 100 - p.bondPct;
    document.getElementById('currency').value       = p.currency;
    document.getElementById('startAmount').value    = p.startAmount === 0 ? '0' :
        Math.round(p.startAmount).toLocaleString('hu-HU').replace(/,/g, ' ');
    document.getElementById('monthlyContrib').value =
        Math.round(p.monthlyContrib).toLocaleString('hu-HU').replace(/,/g, ' ');
    document.getElementById('years').value          = p.years;
    document.getElementById('bondYield').value      = p.bondYield;
    document.getElementById('stockYield').value     = p.stockYield;
    document.getElementById('stockPct').value       = stockPct;
    document.getElementById('expenseRatio').value   = p.expenseRatio;
    document.getElementById('contribGrowth').value  = p.contribGrowth;
    document.getElementById('inflationRate').value  = p.inflationRate;
    updateSliderGradient(stockPct);
    updateSliderLabels(stockPct);
    updateBlendedReturn();
    document.getElementById('contrib-unit').textContent = p.currency + ' / hó';
    calculate();
}

/* ── Csúszka és összetétel ── */
function onSliderChange() {
    const stockPct = parseInt(document.getElementById('stockPct').value);
    activePreset = null;
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.alloc-preset-btn').forEach(b => b.classList.remove('active'));
    updateSliderGradient(stockPct);
    updateSliderLabels(stockPct);
    updateBlendedReturn();
    if (document.getElementById('results').classList.contains('visible')) calculate();
}

function onYieldChange() {
    activePreset = null;
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    updateBlendedReturn();
    if (document.getElementById('results').classList.contains('visible')) calculate();
}

function setAllocPreset(stocks, btn) {
    document.getElementById('stockPct').value = stocks;
    document.querySelectorAll('.alloc-preset-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    activePreset = null;
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    updateSliderGradient(stocks);
    updateSliderLabels(stocks);
    updateBlendedReturn();
    if (document.getElementById('results').classList.contains('visible')) calculate();
}

function updateSliderGradient(stockPct) {
    // Részvény (zöld) bal szélétől a csúszkáig; kötvény (narancs) csúszkától jobb széléig.
    const sl = document.getElementById('stockPct');
    sl.style.background =
        `linear-gradient(to right, var(--green) 0%, var(--green) ${stockPct}%, var(--orange) ${stockPct}%, var(--orange) 100%)`;
}

function updateSliderLabels(stockPct) {
    document.getElementById('stockPctDisplay').textContent = stockPct;
    document.getElementById('bondPctDisplay').textContent  = 100 - stockPct;
}

function updateBlendedReturn() {
    const stockPct  = parseInt(document.getElementById('stockPct').value) / 100;
    const bondPct   = 1 - stockPct;
    const bondYield = parseFloat(document.getElementById('bondYield').value)    || 0;
    const stockYield= parseFloat(document.getElementById('stockYield').value)   || 0;
    const expRatio  = parseFloat(document.getElementById('expenseRatio').value) || 0;
    const gross     = bondPct * bondYield + stockPct * stockYield;
    const net       = gross - expRatio;
    document.getElementById('blendedReturn').innerHTML =
        `<strong>${gross.toFixed(2)}% / év bruttó</strong> &nbsp;·&nbsp; ${net.toFixed(2)}% költségek után`;
}

function recalculate() {
    activePreset = null;
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    const sym = document.getElementById('currency').value;
    document.getElementById('contrib-unit').textContent = sym + ' / hó';
    if (document.getElementById('results').classList.contains('visible')) calculate();
}

/* ── Kalkulációs motor ── */
function calcSeries(startAmount, monthlyContrib, bondPct, stockPct, bondYield, stockYield, expRatio, contribGrowth, years) {
    const grossRate = (bondPct / 100) * (bondYield / 100) + (stockPct / 100) * (stockYield / 100);
    const netRate   = grossRate - expRatio / 100;

    const portfolioNet   = [startAmount];
    const portfolioGross = [startAmount];
    const contributions  = [startAmount];

    let pNet   = startAmount;
    let pGross = startAmount;
    let contrib = monthlyContrib;
    let totalContrib = startAmount;

    for (let y = 1; y <= years; y++) {
        for (let m = 0; m < 12; m++) {
            pNet   = pNet   * (1 + netRate   / 12) + contrib;
            pGross = pGross * (1 + grossRate  / 12) + contrib;
            totalContrib += contrib;
        }
        contrib *= (1 + contribGrowth / 100);
        portfolioNet.push(pNet);
        portfolioGross.push(pGross);
        contributions.push(totalContrib);
    }
    return { portfolioNet, portfolioGross, contributions };
}

/* ── Fő calculate() ── */
function calculate() {
    saveCurrentScenario();

    const showReal  = document.getElementById('realToggle').checked;
    const isTbsz    = tbszMode;
    const activeSym = scenarios[activeScenario].currency;

    const maxYears = Math.max(...scenarios.slice(0, scenarioCount).map(s => s.years));
    const labels   = Array.from({ length: maxYears + 1 }, (_, i) => i + '. év');

    const allDatasets    = [];
    const summaryRows    = [];
    let activeCardData   = null;
    let activeSeriesData = null;

    for (let si = 0; si < scenarioCount; si++) {
        const sc    = scenarios[si];
        const spct  = sc.stockPct;
        const bpct  = 100 - spct;
        const n     = sc.years;
        const color = SCENARIO_COLORS[si];

        const { portfolioNet, portfolioGross, contributions } =
            calcSeries(sc.startAmount, sc.monthlyContrib, bpct, spct,
                       sc.bondYield, sc.stockYield, sc.expenseRatio, sc.contribGrowth, n);

        const deflator    = Array.from({ length: n + 1 }, (_, y) => Math.pow(1 + sc.inflationRate / 100, y));
        const realNet     = portfolioNet.map((v, y) => v / deflator[y]);
        const realGross   = portfolioGross.map((v, y) => v / deflator[y]);
        const realContrib = contributions.map((v, y) => v / deflator[y]);

        const padNull = arr => { const out = [...arr]; while (out.length <= maxYears) out.push(null); return out; };
        const netData  = padNull(showReal ? realNet    : portfolioNet);
        const ideaData = padNull(showReal ? realGross  : portfolioGross);
        const contData = padNull(showReal ? realContrib : contributions);

        const fvNet     = portfolioNet[n];
        const fvGross   = portfolioGross[n];
        const fvContrib = contributions[n];
        const fvDrag    = fvGross - fvNet;
        const fvGrowth  = fvNet - fvContrib;
        const rvNet     = realNet[n];
        const rvGross   = realGross[n];
        const rvContrib = realContrib[n];
        const rvDrag    = rvGross - rvNet;
        const rvGrowth  = rvNet - rvContrib;

        const gainsTax   = Math.max(0, fvGrowth)  * 0.15;
        const tax        = isTbsz ? 0 : gainsTax;
        const afterTax   = fvNet - tax;
        const rvGainsTax = Math.max(0, rvGrowth) * 0.15;
        const rvTax      = isTbsz ? 0 : rvGainsTax;
        const rvAfterTax = rvNet - rvTax;

        summaryRows.push({ name: sc.name, afterTax, fvContrib, fvGrowth, fvDrag, gainsTax,
                           n, sym: sc.currency, color: color.solid });

        if (si === activeScenario) {
            activeCardData = { fvNet, fvGross, fvContrib, fvDrag, fvGrowth, afterTax, tax, gainsTax,
                               rvNet, rvGross, rvContrib, rvDrag, rvGrowth, rvAfterTax, rvTax, rvGainsTax,
                               n, sym: sc.currency, bpct, spct, sc };
            activeSeriesData = { nomNet: portfolioNet, nomContrib: contributions,
                                 realNet, realContrib, n, sym: sc.currency, name: sc.name };
        }

        if (scenarioCount === 1) {
            allDatasets.push(
                { label: 'Összes befizetés',              data: contData, borderColor: tc.contribLine, borderWidth: 1.5, borderDash: [4,3], pointRadius: 0, fill: false,                                     tension: 0   },
                { label: 'Díjmentes ideális (0% díj)',    data: ideaData, borderColor: color.light, borderWidth: 1.5, borderDash: [6,3], pointRadius: 0, fill: false,                                     tension: 0.3 },
                { label: 'Portfóliód (díjak után)',       data: netData,  borderColor: color.solid, backgroundColor: color.area, borderWidth: 2.5, pointRadius: 0, fill: { target: 0, above: color.area }, tension: 0.3 }
            );
        } else {
            allDatasets.push(
                { label: sc.name + ': Befizetések',        data: contData, borderColor: color.faint, borderWidth: 1.5, borderDash: [4,3], pointRadius: 0, fill: false, tension: 0,   hideInLegend: true  },
                { label: sc.name + ': Ideális (0% díj)',   data: ideaData, borderColor: color.light, borderWidth: 1.5, borderDash: [6,3], pointRadius: 0, fill: false, tension: 0.3, hideInLegend: true  },
                { label: sc.name,                          data: netData,  borderColor: color.solid, borderWidth: 2.5,                   pointRadius: 0, fill: false, tension: 0.3, hideInLegend: false }
            );
        }
    }

    // ── Eredménykártyák (aktív forgatókönyv) ──
    const { fvNet, fvGross, fvContrib, fvDrag, fvGrowth, afterTax, gainsTax,
            rvNet, rvGross, rvContrib, rvDrag, rvGrowth, rvAfterTax, rvGainsTax,
            n, sym } = activeCardData;

    const dispFinal    = showReal ? rvAfterTax : afterTax;
    const dispPreTax   = showReal ? rvNet      : fvNet;
    const dispGainsTax = showReal ? rvGainsTax : gainsTax;

    if (isTbsz) {
        setText('val-final',  fmtFull(dispFinal, sym));
        setText('sub-final',  'TBSZ — 0% tőkenyereség-adó');
        setText('real-final', 'Megtakarított adó a normálhoz képest: ' + fmtFull(dispGainsTax, sym));
    } else {
        setText('val-final',  fmtFull(dispFinal, sym));
        setText('sub-final',  showReal ? '15% SZJA után (reál)' : '15% SZJA után a nyereségen');
        setText('real-final', 'Adózás előtt: ' + fmtFull(dispPreTax, sym) + '  ·  Adó: ' + fmtFull(dispGainsTax, sym));
    }

    if (showReal) {
        setText('val-contrib', fmtFull(rvContrib, sym));
        setText('sub-contrib', 'összes befizetett összeg (reál)');
        setText('real-contrib','Nominális: ' + fmtFull(fvContrib, sym));
        setText('val-growth',  fmtFull(rvGrowth, sym));
        setText('sub-growth',  'kamatos kamat összesen (reál)');
        setText('real-growth', 'A befizetések ' + pct(rvGrowth / rvContrib * 100) + '-a');
        setText('val-drag',    fmtFull(rvDrag, sym));
        setText('sub-drag',    'díjakra elveszett ' + n + ' év alatt (reál)');
        setText('real-drag',   'Nominális díjveszteség: ' + fmtFull(fvDrag, sym));
    } else {
        setText('val-contrib', fmtFull(fvContrib, sym));
        setText('sub-contrib', 'összes befizetett összeg ' + n + ' év alatt');
        setText('real-contrib','Reálérték: ' + fmtFull(rvContrib, sym));
        setText('val-growth',  fmtFull(fvGrowth, sym));
        setText('sub-growth',  'kamatos kamat összesen');
        setText('real-growth', 'Az összes befizetés ' + pct(fvGrowth / fvContrib * 100) + '-a');
        setText('val-drag',    fmtFull(fvDrag, sym));
        setText('sub-drag',    'díjakra elveszett ' + n + ' év alatt');
        setText('real-drag',   'Reál díjveszteség: ' + fmtFull(rvDrag, sym));
    }

    // ── Diagram ──
    const tc = getChartColors();
    if (chartInstance) chartInstance.destroy();

    if (chartMode === 'breakdown') {
        const asd       = activeSeriesData;
        const brkLabels = Array.from({ length: asd.n + 1 }, (_, i) => i + '. év');
        const brkCont   = showReal ? asd.realContrib : asd.nomContrib;
        const brkNet    = showReal ? asd.realNet     : asd.nomNet;

        document.getElementById('chart-title').textContent =
            (scenarioCount > 1 ? asd.name + ': ' : '') +
            'Befizetések vs. kamatnövekedés' +
            (showReal ? ' (reál)' : '');

        chartInstance = new Chart(document.getElementById('chart').getContext('2d'), {
            type: 'line',
            data: {
                labels: brkLabels,
                datasets: [
                    {
                        label: 'Saját befizetések',
                        data: brkCont,
                        fill: 'origin',
                        backgroundColor: 'rgba(99,102,241,0.40)',
                        borderColor:     'rgba(99,102,241,0.80)',
                        borderWidth: 1.5,
                        pointRadius: 0,
                        tension: 0.3,
                    },
                    {
                        label: 'Kamatos kamat',
                        data: brkNet,
                        fill: '-1',
                        backgroundColor: 'rgba(22,163,74,0.40)',
                        borderColor:     'rgba(22,163,74,0.80)',
                        borderWidth: 1.5,
                        pointRadius: 0,
                        tension: 0.3,
                    },
                ],
            },
            options: {
                responsive: true,
                aspectRatio: 2.2,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { position: 'top', labels: { boxWidth: 14, font: { size: 12 }, color: tc.legend } },
                    tooltip: {
                        backgroundColor: tc.tooltipBg, titleColor: tc.tooltipText, bodyColor: tc.tooltipText,
                        borderColor: tc.tooltipBorder, borderWidth: 1,
                        callbacks: {
                            label: ctx => {
                                const i = ctx.dataIndex;
                                if (ctx.datasetIndex === 0) {
                                    return '  Befizetések: ' + fmtFull(ctx.parsed.y, sym);
                                }
                                const growthAmt = ctx.parsed.y - (brkCont[i] || 0);
                                return '  Kamatos kamat: ' + fmtFull(growthAmt, sym);
                            },
                        },
                    },
                },
                scales: {
                    x: { grid: { color: tc.grid }, ticks: { maxTicksLimit: 11, font: { size: 11 }, color: tc.tick } },
                    y: { grid: { color: tc.grid }, ticks: { font: { size: 11 }, color: tc.tick, callback: v => fmtShort(v, sym) } },
                },
            },
        });
    } else {
        document.getElementById('chart-title').textContent = showReal
            ? 'Portfólióérték mai vásárlóerőn (inflációval korrigálva)'
            : 'Nominális portfólióérték időben';

        chartInstance = new Chart(document.getElementById('chart').getContext('2d'), {
            type: 'line',
            data: { labels, datasets: allDatasets },
            options: {
                responsive: true,
                aspectRatio: 2.2,
                spanGaps: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            boxWidth: 14,
                            font: { size: 12 },
                            color: tc.legend,
                            filter: (item, chartData) => !chartData.datasets[item.datasetIndex].hideInLegend,
                        },
                    },
                    tooltip: {
                        backgroundColor: tc.tooltipBg, titleColor: tc.tooltipText, bodyColor: tc.tooltipText,
                        borderColor: tc.tooltipBorder, borderWidth: 1,
                        callbacks: {
                            label: ctx => {
                                if (ctx.parsed.y === null) return null;
                                return '  ' + ctx.dataset.label + ': ' + fmtFull(ctx.parsed.y, activeSym);
                            },
                        },
                    },
                },
                scales: {
                    x: { grid: { color: tc.grid }, ticks: { maxTicksLimit: 11, font: { size: 11 }, color: tc.tick } },
                    y: { grid: { color: tc.grid }, ticks: { font: { size: 11 }, color: tc.tick, callback: v => fmtShort(v, activeSym) } },
                },
            },
        });
    }

    // ── Forgatókönyv összehasonlító táblázat ──
    const summaryEl = document.getElementById('scenario-summary');
    if (scenarioCount > 1) {
        const tbody = document.getElementById('summary-tbody');
        tbody.innerHTML = '';
        summaryRows.forEach(r => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><span class="sc-name"><span class="sc-dot" style="background:${r.color}"></span>${r.name}</span></td>
                <td class="final-val">${fmtFull(r.afterTax, r.sym)}</td>
                <td>${fmtFull(r.fvContrib, r.sym)}</td>
                <td>${fmtFull(r.fvGrowth, r.sym)}</td>
                <td>${fmtFull(r.fvDrag, r.sym)}</td>
                <td>${r.n} év</td>`;
            tbody.appendChild(tr);
        });
        summaryEl.style.display = 'block';
    } else {
        summaryEl.style.display = 'none';
    }

    // ── A halogatás ára (aktív forgatókönyv, adó után) ──
    const { bpct, spct, sc } = activeCardData;
    const baseVal = afterTax;
    const dtbody  = document.getElementById('delay-tbody');
    dtbody.innerHTML = '';
    [0, 1, 3, 5].forEach(d => {
        const effYears = Math.max(n - d, 0);
        let finalVal = sc.startAmount;
        if (effYears > 0) {
            const del = calcSeries(sc.startAmount, sc.monthlyContrib, bpct, spct,
                sc.bondYield, sc.stockYield, sc.expenseRatio, sc.contribGrowth, effYears);
            const raw        = del.portfolioNet[effYears];
            const delGrowth  = raw - del.contributions[effYears];
            const delTax     = (isTbsz && effYears >= 5) ? 0 : Math.max(0, delGrowth) * 0.15;
            finalVal = raw - delTax;
        }
        const diff = finalVal - baseVal;
        const isNow = d === 0;
        const tr = document.createElement('tr');
        if (isNow) tr.className = 'now-row';
        const startLabel = isNow ? 'Most' : `${d} évvel később`;
        const diffStr    = isNow ? '—' : `<span class="loss">-${fmtFull(Math.abs(diff), sym)}</span>`;
        tr.innerHTML = `<td>${startLabel}</td><td>${fmtFull(finalVal, sym)}</td><td>${diffStr}</td>`;
        dtbody.appendChild(tr);
    });

    document.getElementById('results').classList.add('visible');
}

// ── Inicializálás ──
window.addEventListener('load', () => {
    updateSliderGradient(50);
    updateBlendedReturn();
    calculate();
});
</script>
{% endblock %}
