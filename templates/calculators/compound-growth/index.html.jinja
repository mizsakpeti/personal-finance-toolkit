{% extends "_calculator_base.html.jinja" %}

{% set lang = "en" %}
{% set use_katex = true %}
{% set root = "../../" %}
{% set nav_all_tools = "All tools" %}
{% set footer_part_of = "Part of" %}
{% set footer_disclaimer = "Not financial advice." %}

{% block title %}Compound Growth Calculator — Build Wealth with Regular Investing{% endblock %}

{% block extra_css_vars %}--green: #16a34a; --orange: #ea580c;{% endblock %}


{% block page_css %}
        /* ── Allocation slider block ── */
        .alloc-block {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1rem 1.1rem 1.1rem;
            margin-bottom: 0.85rem;
        }
        .alloc-block .block-label {
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--muted);
            margin-bottom: 0.75rem;
        }
        .yield-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
            margin-bottom: 0.85rem;
        }
        .yield-field { display: flex; flex-direction: column; gap: 0.2rem; }
        .yield-field label { font-size: 0.78rem; color: var(--muted); font-weight: 500; }
        .yield-input-row { display: flex; align-items: baseline; gap: 0.3rem; }
        .yield-field input {
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 0.3rem 0.5rem;
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text);
            width: 80px;
            outline: none;
            transition: border-color 0.15s;
        }
        .yield-field input:focus { border-color: var(--blue); }
        .yield-field .unit { font-size: 0.85rem; color: var(--muted); }

        .slider-labels {
            display: flex;
            justify-content: space-between;
            font-size: 0.82rem;
            color: var(--muted);
            margin-bottom: 0.3rem;
        }
        .slider-labels .bond-lbl { color: var(--orange); font-weight: 600; }
        .slider-labels .stock-lbl { color: var(--green); font-weight: 600; }
        .slider-labels .split-info { font-weight: 600; color: var(--text); }

        input[type="range"]#stockPct {
            -webkit-appearance: none;
            appearance: none;
            width: 100%;
            height: 8px;
            border-radius: 4px;
            outline: none;
            cursor: pointer;
            border: none;
            background: linear-gradient(to right, var(--orange) 50%, var(--green) 50%);
            margin: 0.4rem 0 0.6rem;
        }
        input[type="range"]#stockPct::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: var(--white);
            border: 2.5px solid var(--blue);
            cursor: pointer;
            box-shadow: 0 1px 4px rgba(0,0,0,0.18);
        }
        input[type="range"]#stockPct::-moz-range-thumb {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: var(--white);
            border: 2.5px solid var(--blue);
            cursor: pointer;
            box-shadow: 0 1px 4px rgba(0,0,0,0.18);
        }

        .blended-return {
            font-size: 0.88rem;
            color: var(--muted);
            margin-bottom: 0.85rem;
        }
        .blended-return strong { color: var(--text); }

        .alloc-presets { display: flex; gap: 0.5rem; flex-wrap: wrap; }
        .alloc-preset-btn {
            padding: 0.25rem 0.7rem;
            border: 1px solid var(--border);
            background: var(--white);
            border-radius: 16px;
            cursor: pointer;
            font-size: 0.8rem;
            color: var(--muted);
            transition: all 0.15s;
        }
        .alloc-preset-btn:hover { border-color: var(--blue); color: var(--blue); background: #eff6ff; }
        .alloc-preset-btn.active { border-color: var(--blue); color: var(--blue); background: #eff6ff; font-weight: 600; }

        /* ── Scenario tabs ── */
        .scenario-bar {
            display: flex;
            align-items: flex-end;
            gap: 0;
            margin-bottom: 1.25rem;
            border-bottom: 2px solid var(--border);
        }
        .scenario-tab {
            padding: 0.45rem 1.1rem;
            border: 1px solid var(--border);
            border-bottom: none;
            background: var(--bg);
            border-radius: 6px 6px 0 0;
            cursor: pointer;
            font-size: 0.88rem;
            font-weight: 500;
            color: var(--muted);
            transition: all 0.15s;
            position: relative;
            bottom: -2px;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            margin-right: 3px;
        }
        .scenario-tab:hover { color: var(--text); background: var(--white); }
        .scenario-tab.active {
            background: var(--white);
            color: var(--text);
            font-weight: 700;
            border-bottom: 2px solid var(--white);
        }
        .tab-dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .add-scenario-btn {
            padding: 0.35rem 0.75rem;
            border: 1px dashed var(--border);
            background: transparent;
            border-radius: 6px 6px 0 0;
            cursor: pointer;
            font-size: 0.8rem;
            color: var(--muted);
            transition: all 0.15s;
            margin-left: 0.5rem;
            bottom: -2px;
            position: relative;
        }
        .add-scenario-btn:hover { border-color: var(--blue); color: var(--blue); }

        /* ── Scenario summary table ── */
        .scenario-summary {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
            display: none;
        }
        .scenario-summary h3 { font-size: 0.95rem; font-weight: 700; margin-bottom: 1rem; }
        .summary-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
        .summary-table th {
            text-align: left;
            padding: 0.35rem 0.75rem;
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--muted);
            border-bottom: 1px solid var(--border);
        }
        .summary-table td { padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
        .summary-table tr:last-child td { border-bottom: none; }
        .summary-table .sc-name { display: flex; align-items: center; gap: 0.5rem; font-weight: 600; }
        .summary-table .sc-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
        .summary-table .final-val { font-weight: 700; }

        /* ── Account type toggle ── */
        .account-type-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }
        .account-type-label { font-size: 0.88rem; color: var(--muted); }
        .account-opt {
            padding: 0.35rem 0.85rem;
            border: 1px solid var(--border);
            background: var(--white);
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.85rem;
            color: var(--muted);
            transition: all 0.15s;
        }
        .account-opt:hover { border-color: var(--blue); color: var(--blue); background: #eff6ff; }
        .account-opt.active { border-color: var(--blue); color: var(--blue); background: #eff6ff; font-weight: 600; }

        /* ── Chart mode switcher ── */
        .chart-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: 1.1rem;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        .chart-header h3 { margin-bottom: 0; }
        .chart-mode-tabs { display: flex; gap: 0.4rem; }
        .chart-mode-btn {
            padding: 0.22rem 0.6rem;
            border: 1px solid var(--border);
            background: var(--white);
            border-radius: 12px;
            cursor: pointer;
            font-size: 0.78rem;
            color: var(--muted);
            transition: all 0.15s;
        }
        .chart-mode-btn:hover { border-color: var(--blue); color: var(--blue); }
        .chart-mode-btn.active { border-color: var(--blue); color: var(--blue); background: #eff6ff; font-weight: 600; }

        /* ── Result card highlights ── */
        .result-card.highlight-green  { border-color: #bbf7d0; background: #f0fdf4; }
        .result-card.highlight-orange { border-color: #fed7aa; background: #fff7ed; }
        .result-card.highlight-green  .r-value { color: var(--green); }
        .result-card.highlight-orange .r-value { color: var(--orange); }

        /* ── Cost-of-delay panel ── */
        .delay-panel {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
        }
        .delay-panel h3 { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.15rem; }
        .delay-panel .delay-subtitle { font-size: 0.82rem; color: var(--muted); margin-bottom: 1rem; }
        .delay-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
        .delay-table th { text-align: left; padding: 0.35rem 0.6rem; font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); border-bottom: 1px solid var(--border); }
        .delay-table td { padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--border); }
        .delay-table tr:last-child td { border-bottom: none; }
        .delay-table .now-row td { font-weight: 700; color: var(--green); }
        .delay-table .loss { color: var(--orange); font-weight: 600; }
{% endblock %}

{% block lang_switch %}
        <div class="lang-switch">
            <span class="current">EN</span>
            <span class="sep">|</span>
            <a href="hu/">HU</a>
        </div>
{% endblock %}

{% block content %}
<!-- ── Opening narrative ── -->
<div class="article">
    <div class="container">
        <div class="meta">Personal Finance · Calculator</div>
        <h1>The Two Levers of Wealth: Time and Consistency</h1>
        <p class="subtitle">You don't need a large sum to start investing. You need a regular habit and enough time to let it compound.</p>

        <div class="tldr">
            <div class="tldr-label">TL;DR</div>
            <ul>
                <li>Regular monthly contributions compound dramatically over time — even modest amounts.</li>
                <li>Starting early matters more than starting big. Delaying by 5 years typically costs around 30–40% of your final portfolio.</li>
                <li>Fees quietly eat into returns: a 1.5% annual cost vs. 0.2% index ETF often makes a six-figure difference over 20 years.</li>
            </ul>
            <a href="#calculator">↓ Jump to the calculator</a>
        </div>

        <p>The most common reason people give for not investing is "I don't have enough to start." It's a reasonable-sounding excuse, and it's almost always wrong. The math of compound growth doesn't require a large starting amount. It requires two things: regular contributions, and time.</p>

        <p>The problem is that modest amounts feel invisible at first. Putting away 30,000 forints a month doesn't feel like building wealth — it feels like a small transfer that won't amount to anything significant. The issue is that our intuitions about growth are linear, and compound growth is not. After one year, the change is barely visible. After ten, it's unmistakable. After twenty, it's the kind of number that makes people wish they had started sooner.</p>

        <blockquote>"The best time to plant a tree was twenty years ago. The second best time is now."</blockquote>

        <p>This calculator models the building phase: what happens when you contribute regularly, choose a portfolio allocation, and let compound interest do its work over time. Two numbers will probably surprise you — how much of the final value came from growth rather than your own contributions, and how much starting a few years later would have cost.</p>

        <p>A note on allocation: the split between bonds and stocks changes the shape of your journey as much as the destination. Bonds provide stability; stocks provide long-run growth. Neither extreme is right for everyone. The allocation slider lets you find your own balance — and see immediately how it affects outcomes.</p>

        <hr class="section-break">
    </div>
</div>

<!-- ── Calculator ── -->
<div class="calculator" id="calculator">
    <div class="container">
        <div class="calc-title">Build your investment projection</div>

        <!-- Scenario tabs -->
        <div class="scenario-bar" id="scenario-bar">
            <button class="scenario-tab active" id="tab-0" onclick="switchScenario(0)">
                <span class="tab-dot" style="background:#2563eb"></span> Scenario A
            </button>
            <button class="add-scenario-btn" id="add-scenario-btn" onclick="addScenario()">+ Add scenario</button>
        </div>

        <div class="presets">
            <span class="presets-label">Load preset:</span>
            <button class="preset-btn active" id="preset-hu" onclick="loadPreset('hu', this)">🇭🇺 Hungary 2025</button>
            <button class="preset-btn" id="preset-eu" onclick="loadPreset('eu', this)">🇪🇺 Eurozone 2025</button>
        </div>

        <!-- Input grid -->
        <div class="input-grid">
            <div class="input-group">
                <label>Starting Amount</label>
                <div class="row">
                    <input type="text" id="startAmount" value="0" inputmode="numeric"
                           style="flex:1;min-width:0;"
                           onfocus="unformatAmount(this)"
                           onblur="formatAmountDisplay(this); recalculate()"
                           oninput="recalculate()">
                    <select id="currency" oninput="recalculate()" style="width:auto;flex-shrink:0;">
                        <option value="Ft" selected>Ft HUF</option>
                        <option value="€">€ EUR</option>
                        <option value="$">$ USD</option>
                        <option value="£">£ GBP</option>
                        <option value="CHF">CHF</option>
                    </select>
                </div>
            </div>

            <div class="input-group">
                <label>Monthly Contribution</label>
                <div class="row">
                    <input type="text" id="monthlyContrib" value="30 000" inputmode="numeric"
                           style="flex:1;min-width:0;"
                           onfocus="unformatAmount(this)"
                           onblur="formatAmountDisplay(this); recalculate()"
                           oninput="recalculate()">
                    <span class="unit" id="contrib-unit">Ft / mo</span>
                </div>
            </div>

            <div class="input-group">
                <label>Time Horizon</label>
                <div class="row">
                    <input type="number" id="years" value="20" min="1" max="50" step="1" oninput="recalculate()">
                    <span class="unit">years</span>
                </div>
            </div>

            <div class="input-group">
                <label>Annual Contribution Growth</label>
                <div class="row">
                    <input type="number" id="contribGrowth" value="0" min="0" max="20" step="0.5" oninput="recalculate()">
                    <span class="unit">% / year</span>
                </div>
            </div>

            <div class="input-group">
                <label>Expense Ratio (fund cost)</label>
                <div class="row">
                    <input type="number" id="expenseRatio" value="0.5" min="0" max="5" step="0.1" oninput="onYieldChange()">
                    <span class="unit">% / year</span>
                </div>
            </div>

            <div class="input-group">
                <label>Inflation Rate</label>
                <div class="row">
                    <input type="number" id="inflationRate" value="4.5" min="0" max="30" step="0.1" oninput="recalculate()">
                    <span class="unit">% / year</span>
                </div>
            </div>
        </div>

        <!-- Allocation slider -->
        <div class="alloc-block">
            <div class="block-label">Portfolio Allocation &amp; Yields</div>

            <div class="yield-row">
                <div class="yield-field">
                    <label>Bond yield (annual)</label>
                    <div class="yield-input-row">
                        <input type="number" id="bondYield" value="6.5" min="0" max="30" step="0.1" oninput="onYieldChange()">
                        <span class="unit">%</span>
                    </div>
                </div>
                <div class="yield-field">
                    <label>Stock yield (annual)</label>
                    <div class="yield-input-row">
                        <input type="number" id="stockYield" value="8.0" min="0" max="30" step="0.1" oninput="onYieldChange()">
                        <span class="unit">%</span>
                    </div>
                </div>
            </div>

            <div class="slider-labels">
                <span class="stock-lbl">Stocks <span id="stockPctDisplay">50</span>%</span>
                <span class="split-info" id="blendedReturn">Blended: 7.25% / yr</span>
                <span class="bond-lbl"><span id="bondPctDisplay">50</span>% Bonds</span>
            </div>
            <input type="range" id="stockPct" min="0" max="100" value="50" oninput="onSliderChange()">

            <div class="alloc-presets">
                <span style="font-size:0.78rem;color:var(--muted);align-self:center;">Quick select:</span>
                <button class="alloc-preset-btn" onclick="setAllocPreset(20, this)">Conservative (80/20)</button>
                <button class="alloc-preset-btn active" onclick="setAllocPreset(50, this)">Balanced (50/50)</button>
                <button class="alloc-preset-btn" onclick="setAllocPreset(80, this)">Growth (20/80)</button>
                <button class="alloc-preset-btn" onclick="setAllocPreset(100, this)">All stocks</button>
            </div>
        </div>

        <!-- Toggles -->
        <label class="toggle-row" for="realToggle">
            <span class="toggle">
                <input type="checkbox" id="realToggle" onchange="recalculate()">
                <span class="toggle-track"></span>
                <span class="toggle-thumb"></span>
            </span>
            Show values in today's purchasing power (inflation-adjusted)
        </label>

        <div class="account-type-row">
            <span class="account-type-label">Account type:</span>
            <button class="account-opt active" id="btn-regular" onclick="setAccountType('regular')">Regular (15% gains tax)</button>
            <button class="account-opt" id="btn-tbsz"    onclick="setAccountType('tbsz')">TBSZ (0% after 5 years)</button>
        </div>

        <!-- Results -->
        <div class="results" id="results">

            <div class="result-cards">
                <div class="result-card highlight-green">
                    <div class="r-label">Final Portfolio Value</div>
                    <div class="r-value" id="val-final"></div>
                    <div class="r-sub"  id="sub-final"></div>
                    <div class="r-real" id="real-final"></div>
                </div>
                <div class="result-card">
                    <div class="r-label">Total Contributed</div>
                    <div class="r-value" id="val-contrib"></div>
                    <div class="r-sub"  id="sub-contrib"></div>
                    <div class="r-real" id="real-contrib"></div>
                </div>
                <div class="result-card">
                    <div class="r-label">Compound Growth Added</div>
                    <div class="r-value" id="val-growth"></div>
                    <div class="r-sub"  id="sub-growth"></div>
                    <div class="r-real" id="real-growth"></div>
                </div>
                <div class="result-card highlight-orange">
                    <div class="r-label">Fee Drag (total cost)</div>
                    <div class="r-value" id="val-drag"></div>
                    <div class="r-sub"  id="sub-drag"></div>
                    <div class="r-real" id="real-drag"></div>
                </div>
            </div>

            <!-- Main chart -->
            <div class="chart-wrap">
                <div class="chart-header">
                    <h3 id="chart-title">Portfolio value over time</h3>
                    <div class="chart-mode-tabs">
                        <button class="chart-mode-btn active" id="mode-portfolio"  onclick="setChartMode('portfolio')">Portfolio value</button>
                        <button class="chart-mode-btn"        id="mode-breakdown"  onclick="setChartMode('breakdown')">Contribution breakdown</button>
                    </div>
                </div>
                <canvas id="chart"></canvas>
            </div>

            <!-- Cost of starting later -->
            <div class="delay-panel">
                <h3>The cost of starting later</h3>
                <p class="delay-subtitle">What if you delayed? All other inputs held constant.</p>
                <table class="delay-table">
                    <thead>
                        <tr>
                            <th>When you start</th>
                            <th>Final portfolio</th>
                            <th>Difference</th>
                        </tr>
                    </thead>
                    <tbody id="delay-tbody">
                    </tbody>
                </table>
            </div>

            <!-- Scenario comparison (shown when >1 scenario) -->
            <div class="scenario-summary" id="scenario-summary">
                <h3>Scenario comparison</h3>
                <table class="summary-table">
                    <thead>
                        <tr>
                            <th>Scenario</th>
                            <th>Final portfolio</th>
                            <th>Contributed</th>
                            <th>Growth</th>
                            <th>Fee drag</th>
                            <th>Years</th>
                        </tr>
                    </thead>
                    <tbody id="summary-tbody"></tbody>
                </table>
            </div>

        </div><!-- /results -->
    </div>
</div>

<!-- ── Post-calculator narrative ── -->
<div class="post-calc">
    <div class="container">
        <h2>How to read this</h2>
        <p>The gap between the <em>portfolio</em> line and the <em>contributions</em> line is compound growth — money your money earned for you. In the early years it's barely visible. Around the halfway mark it starts to accelerate. By year 20 or 30, it typically dwarfs what you actually deposited. This is why starting early, even with small amounts, matters more than most people expect.</p>

        <p>The dashed line is the <em>cost-free ideal</em>: what your portfolio would be with zero fees. The gap between the solid and dashed lines is what annual expense ratios quietly remove over time. A 1.5% annual cost sounds trivial — it's the difference between an index ETF and an actively managed fund sold at a bank. At 20-year horizons on a modest portfolio, that gap typically runs into several million forints.</p>

        <div class="insight-box">
            <strong>The compounding surprise</strong>
            On a 20-year horizon with 30,000 Ft/month contributions and a 7% blended return, roughly 55–60% of the final portfolio value came from compound growth — not from the money you deposited. Most people who see this number for the first time find it difficult to believe.
        </div>

        <h2>What to do next</h2>
        <p>The two practical questions this calculator raises: what should you invest in, and where should you hold it?</p>
        <ul>
            <li><strong>For bonds (HU):</strong> PMÁP and FIXMÁP are available directly at <a href="https://www.allampapir.hu" target="_blank" rel="noopener">allampapir.hu</a>. Buy directly, not through a bank that charges custody fees.</li>
            <li><strong>For stocks / index funds:</strong> A low-cost MSCI World index ETF through <a href="https://ibkr.com" target="_blank" rel="noopener">Interactive Brokers</a> or <a href="https://lightyear.com" target="_blank" rel="noopener">Lightyear</a> is a common choice for Hungarian retail investors. Both are accessible in English and Hungarian, with no account minimums. If you open an account with Lightyear, you can use <a href="https://lightyear.com/profile/peter858" target="_blank" rel="noopener">my referral link</a>.</li>
            <li><strong>Account type:</strong> Consider opening a TBSZ account (Tartós Befektetési Számla). After a 5-year lock-in, gains are fully tax-free — a meaningful advantage for long-horizon portfolios.</li>
        </ul>

        <p>Further reading: <a href="https://kiszamolo.hu" target="_blank" rel="noopener">Kiszámoló</a> covers Hungarian personal finance in accessible, jargon-free Hungarian. It's probably the best starting point for anyone new to this.</p>

        <div class="insight-box">
            <strong>Also see</strong>
            If you already have savings sitting in a bank account, check out the <a href="../cash-opportunity-cost/">Cash Opportunity Cost Calculator</a> — it shows what keeping too much in cash is costing you right now, before you've even started building.
        </div>
    </div>
</div>

<!-- ── How it works ── -->
<div class="how-it-works">
    <div class="container">
        <h2>How the calculation works</h2>
        <p>The portfolio is compounded monthly. Each month, the current balance earns one twelfth of the annual blended return, then the monthly contribution is added. The annual contribution growth is applied once per year at year-end. The blended return is the weighted average of bond and stock yields, net of the annual expense ratio.</p>
        <div class="formula-box" id="math-formulas">
            $$r_{\text{blended}} = w_{\text{bond}} \cdot r_{\text{bond}} + w_{\text{stock}} \cdot r_{\text{stock}}$$
            $$r_{\text{net}} = r_{\text{blended}} - r_{\text{cost}}$$
            $$P_{m+1} = P_m \cdot \left(1 + \frac{r_{\text{net}}}{12}\right) + C_{\text{month}}$$
            $$C_{\text{year}+1} = C_{\text{year}} \cdot (1 + g)$$
            $$\text{Real value} = \frac{FV}{(1 + r_{\text{inflation}})^n}$$
        </div>
        <p>Where <em>w</em> are the portfolio weights (summing to 1), <em>C</em> is the monthly contribution, <em>g</em> is the annual contribution growth rate, and <em>n</em> is the number of years. The cost-free ideal uses <em>r</em><sub>blended</sub> in place of <em>r</em><sub>net</sub>.</p>
        <p class="disclaimer">Preset rates are approximate figures for 2025. Hungarian bond yield based on PMÁP / FIXMÁP products; stock yield based on MSCI World historical nominal return. Eurozone bond yield based on average EU government bond rates. All returns are pre-tax nominal unless the inflation toggle is enabled. Past returns are not a guarantee of future performance. Not financial advice.</p>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
/* ── Formatting helpers ── */
function formatAmountDisplay(el) {
    const raw = parseFloat(el.value.replace(/\s/g, '').replace(',', '.'));
    if (!isNaN(raw) && raw >= 0) el.value = Math.round(raw).toLocaleString('hu-HU').replace(/,/g, ' ');
}
function unformatAmount(el) {
    el.value = el.value.replace(/\s/g, '');
}
function getFieldAmount(id) {
    return parseFloat(document.getElementById(id).value.replace(/\s/g, '').replace(',', '.')) || 0;
}
function fmtFull(value, sym) {
    const rounded = Math.round(value);
    const formatted = Math.abs(rounded).toLocaleString('hu-HU').replace(/,/g, ' ');
    const prefix = rounded < 0 ? '-' : '';
    return sym === 'Ft' ? prefix + formatted + ' Ft' : prefix + sym + ' ' + formatted;
}
function fmtShort(value, sym) {
    const abs = Math.abs(value);
    const sign = value < 0 ? '-' : '';
    let s;
    if (abs >= 1e9)      s = (abs / 1e9).toFixed(1) + ' B';
    else if (abs >= 1e6) s = (abs / 1e6).toFixed(2) + ' M';
    else if (abs >= 1e3) s = (abs / 1e3).toFixed(1) + ' K';
    else                 s = Math.round(abs).toString();
    return sym === 'Ft' ? sign + s + ' Ft' : sign + sym + ' ' + s;
}
function pct(v) { return v.toFixed(2) + '%'; }
function setText(id, text) { document.getElementById(id).textContent = text; }

/* ── Scenario colors ── */
const SCENARIO_COLORS = [
    { solid: '#2563eb', light: 'rgba(37,99,235,0.50)',  faint: 'rgba(37,99,235,0.25)',  area: 'rgba(37,99,235,0.08)' },
    { solid: '#16a34a', light: 'rgba(22,163,74,0.50)',  faint: 'rgba(22,163,74,0.25)',  area: 'rgba(22,163,74,0.08)'  },
    { solid: '#ea580c', light: 'rgba(234,88,12,0.50)',  faint: 'rgba(234,88,12,0.25)',  area: 'rgba(234,88,12,0.08)'  },
];
const SCENARIO_LABELS = ['A', 'B', 'C'];

/* ── Scenario state ── */
const DEFAULT_SCENARIO = {
    currency: 'Ft', startAmount: 0, monthlyContrib: 30000, years: 20,
    stockPct: 50, bondYield: 6.5, stockYield: 8.0,
    expenseRatio: 0.5, contribGrowth: 0, inflationRate: 4.5,
};
let scenarios     = [{ ...DEFAULT_SCENARIO, name: 'Scenario A' }];
let scenarioCount = 1;
let activeScenario = 0;

/* ── Presets ── */
const PRESETS = {
    hu: { currency: 'Ft', startAmount: 0, monthlyContrib: 30000, years: 20,
          bondYield: 6.5, stockYield: 8.0, bondPct: 50, expenseRatio: 0.5,
          contribGrowth: 0, inflationRate: 4.5 },
    eu: { currency: '€',  startAmount: 0, monthlyContrib: 300,   years: 20,
          bondYield: 3.0, stockYield: 8.0, bondPct: 50, expenseRatio: 0.5,
          contribGrowth: 0, inflationRate: 2.3 },
};

let chartInstance = null;
let activePreset  = 'hu';
let tbszMode      = false;
let chartMode     = 'portfolio';

function setAccountType(type) {
    tbszMode = (type === 'tbsz');
    document.getElementById('btn-regular').classList.toggle('active', !tbszMode);
    document.getElementById('btn-tbsz').classList.toggle('active',  tbszMode);
    if (document.getElementById('results').classList.contains('visible')) calculate();
}

function setChartMode(mode) {
    chartMode = mode;
    document.getElementById('mode-portfolio').classList.toggle('active', mode === 'portfolio');
    document.getElementById('mode-breakdown').classList.toggle('active', mode === 'breakdown');
    if (document.getElementById('results').classList.contains('visible')) calculate();
}

/* ── Save / load scenario state ── */
function saveCurrentScenario() {
    const spct = parseInt(document.getElementById('stockPct').value) || 50;
    scenarios[activeScenario] = {
        name:          scenarios[activeScenario].name,
        currency:      document.getElementById('currency').value,
        startAmount:   getFieldAmount('startAmount'),
        monthlyContrib:getFieldAmount('monthlyContrib'),
        years:         parseInt(document.getElementById('years').value)          || 20,
        stockPct:      spct,
        bondYield:     parseFloat(document.getElementById('bondYield').value)    || 0,
        stockYield:    parseFloat(document.getElementById('stockYield').value)   || 0,
        expenseRatio:  parseFloat(document.getElementById('expenseRatio').value) || 0,
        contribGrowth: parseFloat(document.getElementById('contribGrowth').value)|| 0,
        inflationRate: parseFloat(document.getElementById('inflationRate').value)|| 0,
    };
}

function loadScenarioToDOM(idx) {
    const s = scenarios[idx];
    document.getElementById('currency').value = s.currency;
    document.getElementById('startAmount').value = s.startAmount === 0 ? '0' :
        Math.round(s.startAmount).toLocaleString('hu-HU').replace(/,/g, ' ');
    document.getElementById('monthlyContrib').value =
        Math.round(s.monthlyContrib).toLocaleString('hu-HU').replace(/,/g, ' ');
    document.getElementById('years').value          = s.years;
    document.getElementById('stockPct').value       = s.stockPct;
    document.getElementById('bondYield').value      = s.bondYield;
    document.getElementById('stockYield').value     = s.stockYield;
    document.getElementById('expenseRatio').value   = s.expenseRatio;
    document.getElementById('contribGrowth').value  = s.contribGrowth;
    document.getElementById('inflationRate').value  = s.inflationRate;
    document.getElementById('contrib-unit').textContent = s.currency + ' / mo';
    updateSliderGradient(s.stockPct);
    updateSliderLabels(s.stockPct);
    updateBlendedReturn();
}

/* ── Scenario tab management ── */
function switchScenario(idx) {
    saveCurrentScenario();
    activeScenario = idx;
    document.querySelectorAll('.scenario-tab').forEach((tab, i) =>
        tab.classList.toggle('active', i === idx));
    loadScenarioToDOM(idx);
    if (document.getElementById('results').classList.contains('visible')) calculate();
}

function addScenario() {
    if (scenarioCount >= 3) return;
    saveCurrentScenario();
    const newIdx = scenarioCount;
    scenarios[newIdx] = {
        ...scenarios[activeScenario],
        name: 'Scenario ' + SCENARIO_LABELS[newIdx],
    };
    scenarioCount++;

    // Insert new tab before the "+ Add" button
    const bar = document.getElementById('scenario-bar');
    const addBtn = document.getElementById('add-scenario-btn');
    const color = SCENARIO_COLORS[newIdx].solid;
    const tab = document.createElement('button');
    tab.className = 'scenario-tab';
    tab.id = 'tab-' + newIdx;
    tab.innerHTML = `<span class="tab-dot" style="background:${color}"></span> Scenario ${SCENARIO_LABELS[newIdx]}`;
    tab.onclick = () => switchScenario(newIdx);
    bar.insertBefore(tab, addBtn);

    if (scenarioCount >= 3) addBtn.style.display = 'none';
    switchScenario(newIdx);
}

/* ── Preset loading ── */
function loadPreset(key, btn) {
    activePreset = key;
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const p = PRESETS[key];
    const stockPct = 100 - p.bondPct;
    document.getElementById('currency').value       = p.currency;
    document.getElementById('startAmount').value    = p.startAmount === 0 ? '0' :
        Math.round(p.startAmount).toLocaleString('hu-HU').replace(/,/g, ' ');
    document.getElementById('monthlyContrib').value =
        Math.round(p.monthlyContrib).toLocaleString('hu-HU').replace(/,/g, ' ');
    document.getElementById('years').value          = p.years;
    document.getElementById('bondYield').value      = p.bondYield;
    document.getElementById('stockYield').value     = p.stockYield;
    document.getElementById('stockPct').value       = stockPct;
    document.getElementById('expenseRatio').value   = p.expenseRatio;
    document.getElementById('contribGrowth').value  = p.contribGrowth;
    document.getElementById('inflationRate').value  = p.inflationRate;
    updateSliderGradient(stockPct);
    updateSliderLabels(stockPct);
    updateBlendedReturn();
    document.getElementById('contrib-unit').textContent = p.currency + ' / mo';
    calculate();
}

/* ── Slider & allocation ── */
function onSliderChange() {
    const stockPct = parseInt(document.getElementById('stockPct').value);
    activePreset = null;
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.alloc-preset-btn').forEach(b => b.classList.remove('active'));
    updateSliderGradient(stockPct);
    updateSliderLabels(stockPct);
    updateBlendedReturn();
    if (document.getElementById('results').classList.contains('visible')) calculate();
}

function onYieldChange() {
    activePreset = null;
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    updateBlendedReturn();
    if (document.getElementById('results').classList.contains('visible')) calculate();
}

function setAllocPreset(stocks, btn) {
    document.getElementById('stockPct').value = stocks;
    document.querySelectorAll('.alloc-preset-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    activePreset = null;
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    updateSliderGradient(stocks);
    updateSliderLabels(stocks);
    updateBlendedReturn();
    if (document.getElementById('results').classList.contains('visible')) calculate();
}

function updateSliderGradient(stockPct) {
    // Stocks (green) fill left-to-thumb; bonds (orange) fill thumb-to-right.
    // This keeps the thumb exactly at the colour boundary.
    const sl = document.getElementById('stockPct');
    sl.style.background =
        `linear-gradient(to right, var(--green) 0%, var(--green) ${stockPct}%, var(--orange) ${stockPct}%, var(--orange) 100%)`;
}

function updateSliderLabels(stockPct) {
    document.getElementById('stockPctDisplay').textContent = stockPct;
    document.getElementById('bondPctDisplay').textContent  = 100 - stockPct;
}

function updateBlendedReturn() {
    const stockPct  = parseInt(document.getElementById('stockPct').value) / 100;
    const bondPct   = 1 - stockPct;
    const bondYield = parseFloat(document.getElementById('bondYield').value)    || 0;
    const stockYield= parseFloat(document.getElementById('stockYield').value)   || 0;
    const expRatio  = parseFloat(document.getElementById('expenseRatio').value) || 0;
    const gross     = bondPct * bondYield + stockPct * stockYield;
    const net       = gross - expRatio;
    document.getElementById('blendedReturn').innerHTML =
        `<strong>${gross.toFixed(2)}% / yr gross</strong> &nbsp;·&nbsp; ${net.toFixed(2)}% after costs`;
}

function recalculate() {
    activePreset = null;
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    const sym = document.getElementById('currency').value;
    document.getElementById('contrib-unit').textContent = sym + ' / mo';
    if (document.getElementById('results').classList.contains('visible')) calculate();
}

/* ── Core calculation engine ── */
function calcSeries(startAmount, monthlyContrib, bondPct, stockPct, bondYield, stockYield, expRatio, contribGrowth, years) {
    const grossRate = (bondPct / 100) * (bondYield / 100) + (stockPct / 100) * (stockYield / 100);
    const netRate   = grossRate - expRatio / 100;

    const portfolioNet   = [startAmount];
    const portfolioGross = [startAmount];
    const contributions  = [startAmount];

    let pNet   = startAmount;
    let pGross = startAmount;
    let contrib = monthlyContrib;
    let totalContrib = startAmount;

    for (let y = 1; y <= years; y++) {
        for (let m = 0; m < 12; m++) {
            pNet   = pNet   * (1 + netRate   / 12) + contrib;
            pGross = pGross * (1 + grossRate  / 12) + contrib;
            totalContrib += contrib;
        }
        contrib *= (1 + contribGrowth / 100);
        portfolioNet.push(pNet);
        portfolioGross.push(pGross);
        contributions.push(totalContrib);
    }
    return { portfolioNet, portfolioGross, contributions };
}

/* ── Main calculate() ── */
function calculate() {
    saveCurrentScenario();

    const showReal  = document.getElementById('realToggle').checked;
    const isTbsz    = tbszMode;
    const activeSym = scenarios[activeScenario].currency;

    const maxYears = Math.max(...scenarios.slice(0, scenarioCount).map(s => s.years));
    const labels   = Array.from({ length: maxYears + 1 }, (_, i) => 'Yr ' + i);

    const allDatasets    = [];
    const summaryRows    = [];
    let activeCardData   = null;
    let activeSeriesData = null;   // for breakdown chart

    for (let si = 0; si < scenarioCount; si++) {
        const sc    = scenarios[si];
        const spct  = sc.stockPct;
        const bpct  = 100 - spct;
        const n     = sc.years;
        const color = SCENARIO_COLORS[si];

        const { portfolioNet, portfolioGross, contributions } =
            calcSeries(sc.startAmount, sc.monthlyContrib, bpct, spct,
                       sc.bondYield, sc.stockYield, sc.expenseRatio, sc.contribGrowth, n);

        const deflator    = Array.from({ length: n + 1 }, (_, y) => Math.pow(1 + sc.inflationRate / 100, y));
        const realNet     = portfolioNet.map((v, y) => v / deflator[y]);
        const realGross   = portfolioGross.map((v, y) => v / deflator[y]);
        const realContrib = contributions.map((v, y) => v / deflator[y]);

        const padNull = arr => { const out = [...arr]; while (out.length <= maxYears) out.push(null); return out; };
        const netData  = padNull(showReal ? realNet    : portfolioNet);
        const ideaData = padNull(showReal ? realGross  : portfolioGross);
        const contData = padNull(showReal ? realContrib : contributions);

        // Pre-tax finals
        const fvNet     = portfolioNet[n];
        const fvGross   = portfolioGross[n];
        const fvContrib = contributions[n];
        const fvDrag    = fvGross - fvNet;
        const fvGrowth  = fvNet - fvContrib;
        const rvNet     = realNet[n];
        const rvGross   = realGross[n];
        const rvContrib = realContrib[n];
        const rvDrag    = rvGross - rvNet;
        const rvGrowth  = rvNet - rvContrib;

        // Tax
        const gainsTax   = Math.max(0, fvGrowth)  * 0.15;
        const tax        = isTbsz ? 0 : gainsTax;
        const afterTax   = fvNet - tax;
        const rvGainsTax = Math.max(0, rvGrowth) * 0.15;
        const rvTax      = isTbsz ? 0 : rvGainsTax;
        const rvAfterTax = rvNet - rvTax;

        summaryRows.push({ name: sc.name, afterTax, fvContrib, fvGrowth, fvDrag, gainsTax,
                           n, sym: sc.currency, color: color.solid });

        if (si === activeScenario) {
            activeCardData = { fvNet, fvGross, fvContrib, fvDrag, fvGrowth, afterTax, tax, gainsTax,
                               rvNet, rvGross, rvContrib, rvDrag, rvGrowth, rvAfterTax, rvTax, rvGainsTax,
                               n, sym: sc.currency, bpct, spct, sc };
            activeSeriesData = { nomNet: portfolioNet, nomContrib: contributions,
                                 realNet, realContrib, n, sym: sc.currency, name: sc.name };
        }

        if (scenarioCount === 1) {
            allDatasets.push(
                { label: 'Total contributed',          data: contData, borderColor: tc.contribLine, borderWidth: 1.5, borderDash: [4,3], pointRadius: 0, fill: false,                                     tension: 0   },
                { label: 'Cost-free ideal (no fees)',  data: ideaData, borderColor: color.light, borderWidth: 1.5, borderDash: [6,3], pointRadius: 0, fill: false,                                     tension: 0.3 },
                { label: 'Your portfolio (after fees)',data: netData,  borderColor: color.solid, backgroundColor: color.area, borderWidth: 2.5, pointRadius: 0, fill: { target: 0, above: color.area }, tension: 0.3 }
            );
        } else {
            allDatasets.push(
                { label: sc.name + ': Contributions',   data: contData, borderColor: color.faint, borderWidth: 1.5, borderDash: [4,3], pointRadius: 0, fill: false, tension: 0,   hideInLegend: true  },
                { label: sc.name + ': Ideal (no fees)', data: ideaData, borderColor: color.light, borderWidth: 1.5, borderDash: [6,3], pointRadius: 0, fill: false, tension: 0.3, hideInLegend: true  },
                { label: sc.name,                       data: netData,  borderColor: color.solid, borderWidth: 2.5,                   pointRadius: 0, fill: false, tension: 0.3, hideInLegend: false }
            );
        }
    }

    // ── Result cards (active scenario) ──
    const { fvNet, fvGross, fvContrib, fvDrag, fvGrowth, afterTax, gainsTax,
            rvNet, rvGross, rvContrib, rvDrag, rvGrowth, rvAfterTax, rvGainsTax,
            n, sym } = activeCardData;

    const dispFinal    = showReal ? rvAfterTax : afterTax;
    const dispPreTax   = showReal ? rvNet      : fvNet;
    const dispGainsTax = showReal ? rvGainsTax : gainsTax;

    if (isTbsz) {
        setText('val-final',  fmtFull(dispFinal, sym));
        setText('sub-final',  'TBSZ — 0% capital gains tax');
        setText('real-final', 'Tax saved vs regular: ' + fmtFull(dispGainsTax, sym));
    } else {
        setText('val-final',  fmtFull(dispFinal, sym));
        setText('sub-final',  showReal ? 'after 15% SZJA (real)' : 'after 15% SZJA on gains');
        setText('real-final', 'Pre-tax: ' + fmtFull(dispPreTax, sym) + '  ·  Tax: ' + fmtFull(dispGainsTax, sym));
    }

    if (showReal) {
        setText('val-contrib', fmtFull(rvContrib, sym));
        setText('sub-contrib', 'total deposited (real)');
        setText('real-contrib','Nominal: ' + fmtFull(fvContrib, sym));
        setText('val-growth',  fmtFull(rvGrowth, sym));
        setText('sub-growth',  'compound interest earned (real)');
        setText('real-growth', pct(rvGrowth / rvContrib * 100) + '% of contribution value');
        setText('val-drag',    fmtFull(rvDrag, sym));
        setText('sub-drag',    'lost to fees over ' + n + ' years (real)');
        setText('real-drag',   'Nominal drag: ' + fmtFull(fvDrag, sym));
    } else {
        setText('val-contrib', fmtFull(fvContrib, sym));
        setText('sub-contrib', 'total deposited over ' + n + ' years');
        setText('real-contrib','Real value: ' + fmtFull(rvContrib, sym));
        setText('val-growth',  fmtFull(fvGrowth, sym));
        setText('sub-growth',  'compound interest earned');
        setText('real-growth', pct(fvGrowth / fvContrib * 100) + '% of total contributions');
        setText('val-drag',    fmtFull(fvDrag, sym));
        setText('sub-drag',    'lost to fees over ' + n + ' years');
        setText('real-drag',   'Real drag: ' + fmtFull(rvDrag, sym));
    }

    // ── Chart ──
    const tc = getChartColors();
    if (chartInstance) chartInstance.destroy();

    if (chartMode === 'breakdown') {
        // Stacked area: what you put in vs what growth added (active scenario)
        const asd       = activeSeriesData;
        const brkLabels = Array.from({ length: asd.n + 1 }, (_, i) => 'Yr ' + i);
        const brkCont   = showReal ? asd.realContrib : asd.nomContrib;
        const brkNet    = showReal ? asd.realNet     : asd.nomNet;

        document.getElementById('chart-title').textContent =
            (scenarioCount > 1 ? asd.name + ': ' : '') +
            'What you contributed vs what growth added' +
            (showReal ? ' (real)' : '');

        chartInstance = new Chart(document.getElementById('chart').getContext('2d'), {
            type: 'line',
            data: {
                labels: brkLabels,
                datasets: [
                    {
                        label: 'Your contributions',
                        data: brkCont,
                        fill: 'origin',
                        backgroundColor: 'rgba(99,102,241,0.40)',
                        borderColor:     'rgba(99,102,241,0.80)',
                        borderWidth: 1.5,
                        pointRadius: 0,
                        tension: 0.3,
                    },
                    {
                        label: 'Compound growth',
                        data: brkNet,
                        fill: '-1',
                        backgroundColor: 'rgba(22,163,74,0.40)',
                        borderColor:     'rgba(22,163,74,0.80)',
                        borderWidth: 1.5,
                        pointRadius: 0,
                        tension: 0.3,
                    },
                ],
            },
            options: {
                responsive: true,
                aspectRatio: 2.2,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { position: 'top', labels: { boxWidth: 14, font: { size: 12 }, color: tc.legend } },
                    tooltip: {
                        backgroundColor: tc.tooltipBg, titleColor: tc.tooltipText, bodyColor: tc.tooltipText,
                        borderColor: tc.tooltipBorder, borderWidth: 1,
                        callbacks: {
                            label: ctx => {
                                const i = ctx.dataIndex;
                                if (ctx.datasetIndex === 0) {
                                    return '  Contributions: ' + fmtFull(ctx.parsed.y, sym);
                                }
                                const growthAmt = ctx.parsed.y - (brkCont[i] || 0);
                                return '  Compound growth: ' + fmtFull(growthAmt, sym);
                            },
                        },
                    },
                },
                scales: {
                    x: { grid: { color: tc.grid }, ticks: { maxTicksLimit: 11, font: { size: 11 }, color: tc.tick } },
                    y: { grid: { color: tc.grid }, ticks: { font: { size: 11 }, color: tc.tick, callback: v => fmtShort(v, sym) } },
                },
            },
        });
    } else {
        // Portfolio value view
        document.getElementById('chart-title').textContent = showReal
            ? 'Portfolio value in today\'s purchasing power (inflation-adjusted)'
            : 'Nominal portfolio value over time';

        chartInstance = new Chart(document.getElementById('chart').getContext('2d'), {
            type: 'line',
            data: { labels, datasets: allDatasets },
            options: {
                responsive: true,
                aspectRatio: 2.2,
                spanGaps: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            boxWidth: 14,
                            font: { size: 12 },
                            color: tc.legend,
                            filter: (item, chartData) => !chartData.datasets[item.datasetIndex].hideInLegend,
                        },
                    },
                    tooltip: {
                        backgroundColor: tc.tooltipBg, titleColor: tc.tooltipText, bodyColor: tc.tooltipText,
                        borderColor: tc.tooltipBorder, borderWidth: 1,
                        callbacks: {
                            label: ctx => {
                                if (ctx.parsed.y === null) return null;
                                return '  ' + ctx.dataset.label + ': ' + fmtFull(ctx.parsed.y, activeSym);
                            },
                        },
                    },
                },
                scales: {
                    x: { grid: { color: tc.grid }, ticks: { maxTicksLimit: 11, font: { size: 11 }, color: tc.tick } },
                    y: { grid: { color: tc.grid }, ticks: { font: { size: 11 }, color: tc.tick, callback: v => fmtShort(v, activeSym) } },
                },
            },
        });
    }

    // ── Scenario summary table ──
    const summaryEl = document.getElementById('scenario-summary');
    if (scenarioCount > 1) {
        const tbody = document.getElementById('summary-tbody');
        tbody.innerHTML = '';
        summaryRows.forEach(r => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><span class="sc-name"><span class="sc-dot" style="background:${r.color}"></span>${r.name}</span></td>
                <td class="final-val">${fmtFull(r.afterTax, r.sym)}</td>
                <td>${fmtFull(r.fvContrib, r.sym)}</td>
                <td>${fmtFull(r.fvGrowth, r.sym)}</td>
                <td>${fmtFull(r.fvDrag, r.sym)}</td>
                <td>${r.n} yr</td>`;
            tbody.appendChild(tr);
        });
        summaryEl.style.display = 'block';
    } else {
        summaryEl.style.display = 'none';
    }

    // ── Cost of starting later (active scenario, after-tax) ──
    const { bpct, spct, sc } = activeCardData;
    const baseVal = afterTax;
    const dtbody  = document.getElementById('delay-tbody');
    dtbody.innerHTML = '';
    [0, 1, 3, 5].forEach(d => {
        const effYears = Math.max(n - d, 0);
        let finalVal = sc.startAmount;
        if (effYears > 0) {
            const del = calcSeries(sc.startAmount, sc.monthlyContrib, bpct, spct,
                sc.bondYield, sc.stockYield, sc.expenseRatio, sc.contribGrowth, effYears);
            const raw        = del.portfolioNet[effYears];
            const delGrowth  = raw - del.contributions[effYears];
            const delTax     = (isTbsz && effYears >= 5) ? 0 : Math.max(0, delGrowth) * 0.15;
            finalVal = raw - delTax;
        }
        const diff = finalVal - baseVal;
        const isNow = d === 0;
        const tr = document.createElement('tr');
        if (isNow) tr.className = 'now-row';
        const startLabel = isNow ? 'Now' : `${d} year${d > 1 ? 's' : ''} later`;
        const diffStr    = isNow ? '—' : `<span class="loss">-${fmtFull(Math.abs(diff), sym)}</span>`;
        tr.innerHTML = `<td>${startLabel}</td><td>${fmtFull(finalVal, sym)}</td><td>${diffStr}</td>`;
        dtbody.appendChild(tr);
    });

    document.getElementById('results').classList.add('visible');
}

// ── Init ──
window.addEventListener('load', () => {
    updateSliderGradient(50);
    updateBlendedReturn();
    calculate();
});
</script>
{% endblock %}
