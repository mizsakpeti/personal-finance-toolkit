{% set lang = "hu" %}
{% set use_katex = false %}
{% set root = "../../../" %}
{% set nav_all_tools = "Összes eszköz" %}
{% set footer_part_of = "" %}
{% set footer_disclaimer = "" %}
{% extends "_calculator_base.html.jinja" %}

{% block title %}HUF vs EUR — Deviza-hozam kalkulátor{% endblock %}

{% block extra_css_vars %}--green: #16a34a; --orange: #ea580c; --purple: #7c3aed;{% endblock %}
{% block article_padding %}3rem 0 2rem{% endblock %}
{% block article_h1_size %}2rem{% endblock %}
{% block article_subtitle_mb %}1.75rem{% endblock %}
{% block article_p_mb %}1.1rem{% endblock %}
{% block article_p_size %}1.02rem{% endblock %}
{% block calc_title_mb %}0.4rem{% endblock %}
{% block input_grid_mb %}0.25rem{% endblock %}
{% block toggle_row_mb %}{% endblock %}
{% block calc_btn_extra %}margin-top: 1.25rem;{% endblock %}
{% block result_cards_cols %}1fr 1fr 1fr{% endblock %}
{% block result_value_size %}1.3rem{% endblock %}
{% block result_real_size %}0.8rem{% endblock %}
{% block chart_wrap_mb %}0.5rem{% endblock %}
{% block how_it_works_padding %}2rem 0{% endblock %}
{% block how_h2_mb %}0.6rem{% endblock %}
{% block disclaimer_pt %}0.85rem{% endblock %}

{% block lang_switch %}
        <div class="lang-switch">
            <a href="../">EN</a>
            <span class="sep">|</span>
            <span class="current">HU</span>
        </div>
{% endblock %}

{% block page_css %}
        .toggle-row { margin: 1.1rem 0; }

        .breakeven-box {
            background: #faf5ff; border: 1px solid #ddd6fe;
            border-radius: 8px; padding: 1rem 1.25rem;
            margin-bottom: 1.25rem; font-size: 0.93rem; color: #4c1d95;
        }
        .breakeven-box strong { font-size: 1rem; }
        .breakeven-box .be-rate { font-size: 1.4rem; font-weight: 700; margin: 0.2rem 0; }
        .breakeven-box .be-sub { font-size: 0.82rem; opacity: 0.8; }

        .result-card.huf { border-top: 3px solid #f97316; }
        .result-card.eur { border-top: 3px solid #7c3aed; }
        .result-card.diff-pos { border-top: 3px solid var(--green); }
        .result-card.diff-neg { border-top: 3px solid var(--orange); }
        .result-card.eur .r-value { color: var(--purple); }
{% endblock %}

{% block footer %}
<footer>
    A <a href="../../../index.html">Personal Finance Toolkit</a> része ·
    <a href="https://github.com/mizsakpeti/personal-finance-toolkit">GitHub</a> ·
    Nem minősül pénzügyi tanácsadásnak.
</footer>
{% endblock %}

{% block content %}
<div class="article">
    <div class="container">
        <div class="meta">Személyes pénzügy · Kalkulátor</div>
        <h1>HUF vagy EUR — Hol dolgozzon a megtakarításod?</h1>
        <p class="subtitle">A magyar állampapírok jelenleg lényegesen magasabb hozamot kínálnak az eurós alternatíváknál. Az euró ugyanakkor az elmúlt évtizedben erősödött a forinttal szemben, és összességében biztonságosabb devizának tekinthető. Ez a kalkulátor megmutatja, melyik deviza tartása lehet kifizetődőbb — és hogy milyen árfolyamnál fordulna meg a mérleg.</p>

        <p>Az alapvető dilemma: forintban tartod a megtakarításod és élvezed a magasabb kamatot, vagy euróra váltasz, alacsonyabb hozamot elfogadva — cserébe esetleg nyersz az árfolyamon, és nagyobb biztonságban tudod a megtakarításaidat. Egyik sem egyértelműen jobb — minden az EUR/HUF jövőbeli mozgásán múlik.</p>

        <p>Az EUR/HUF az elmúlt évtizedben átlagosan évi 2–3%-ot erősödött — kb. 310 Ft-ról 2015-ben ~403 Ft-ra 2025 tavaszán, majd onnan ~365 Ft-ra mérséklődött 2026-ra. A forint- és eurós kötvények közötti kamatrés jelenleg 4–5 százalékpont körül van. Ez a két erő ellentétes irányba húz — a kalkulátor ezt a feszültséget teszi láthatóvá.</p>
    </div>
</div>

<div class="calculator" id="calculator">
    <div class="container">
        <div class="calc-title">Számold ki a deviza-hozamot</div>
        <div class="calc-desc">Hasonlítsd össze a forintos megtakarítást és az eurós befektetést.</div>

        <p class="section-label">Kiindulópont</p>
        <div class="input-grid">
            <div class="input-group span-2">
                <label>Kezdőösszeg (HUF)</label>
                <div class="row">
                    <input type="text" id="amount" value="5 000 000" inputmode="numeric"
                           style="flex:1;min-width:0;"
                           onfocus="unformatAmount(this)"
                           onblur="formatAmountDisplay(this); recalculate()"
                           oninput="recalculate()">
                    <span class="unit">Ft</span>
                </div>
            </div>
        </div>

        <p class="section-label">Árfolyamok</p>
        <div class="input-grid">
            <div class="input-group">
                <label>Jelenlegi EUR/HUF árfolyam</label>
                <div class="row">
                    <input type="number" id="rateNow" value="365" min="100" max="2000" step="1" oninput="recalculate()">
                    <span class="unit">Ft / €</span>
                </div>
                <div class="hint">1 EUR = ? HUF ma (2026. május: ~365)</div>
            </div>
            <div class="input-group">
                <label>Célárfolyam</label>
                <div class="row">
                    <input type="number" id="rateTarget" value="450" min="100" max="2000" step="1" oninput="recalculate()">
                    <span class="unit">Ft / €</span>
                </div>
                <div class="hint">Saját becslésed az időszak végére</div>
            </div>
        </div>

        <p class="section-label">Kamat és infláció</p>
        <div class="input-grid">
            <div class="input-group">
                <label>Forint kötvényhozam</label>
                <div class="row">
                    <input type="number" id="rateHuf" value="7.0" min="0" max="50" step="0.1" oninput="recalculate()">
                    <span class="unit">% / év</span>
                </div>
                <div class="hint">FixMÁP / MÁP+ (2025. május: 7,0%)</div>
            </div>
            <div class="input-group">
                <label>Eurós megtakarítási kamat</label>
                <div class="row">
                    <input type="number" id="rateEur" value="2.0" min="0" max="50" step="0.1" oninput="recalculate()">
                    <span class="unit">% / év</span>
                </div>
                <div class="hint">EU állampapír / megtakarítás (2026: ~2,0%)</div>
            </div>
            <div class="input-group">
                <label>Forint infláció</label>
                <div class="row">
                    <input type="number" id="inflHuf" value="3.2" min="0" max="50" step="0.1" oninput="recalculate()">
                    <span class="unit">% / év</span>
                </div>
                <div class="hint">MNB 2026-os előrejelzés: ~3,2%</div>
            </div>
        </div>

        <div class="input-grid" style="margin-top:0.85rem;">
            <div class="input-group span-2">
                <label>Időtáv</label>
                <div class="row">
                    <input type="number" id="years" value="5" min="1" max="30" step="1" oninput="recalculate()">
                    <span class="unit">év</span>
                </div>
            </div>
        </div>

        <label class="toggle-row" for="realToggle">
            <span class="toggle">
                <input type="checkbox" id="realToggle" onchange="recalculate()">
                <span class="toggle-track"></span>
                <span class="toggle-thumb"></span>
            </span>
            Értékek megjelenítése mai vásárlóerőn (inflációval korrigálva)
        </label>

        <button class="calc-btn" onclick="calculate()">Számolj →</button>

        <div class="results" id="results">

            <div class="breakeven-box" id="breakeven-box">
                <strong>EUR/HUF fedezeti árfolyam</strong>
                <div class="be-rate" id="be-rate">—</div>
                <div class="be-sub" id="be-sub">—</div>
            </div>

            <div class="result-cards">
                <div class="result-card huf">
                    <div class="r-label">HUF kötvény</div>
                    <div class="r-value" id="val-huf"></div>
                    <div class="r-sub" id="sub-huf"></div>
                    <div class="r-real" id="real-huf"></div>
                </div>
                <div class="result-card eur">
                    <div class="r-label">EUR kötvény (HUF-ban)</div>
                    <div class="r-value" id="val-eur"></div>
                    <div class="r-sub" id="sub-eur"></div>
                    <div class="r-real" id="real-eur"></div>
                </div>
                <div class="result-card" id="card-diff">
                    <div class="r-label">Különbség</div>
                    <div class="r-value" id="val-diff"></div>
                    <div class="r-sub" id="sub-diff"></div>
                    <div class="r-real" id="real-diff"></div>
                </div>
            </div>

            <div class="chart-wrap">
                <h3 id="chart-title">Értékalakulás az évek során (HUF-ban)</h3>
                <canvas id="chart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="how-it-works">
    <div class="container">
        <h2>A számítás menete</h2>
        <p><strong>Forintos út:</strong> a kezdőösszeg a megadott HUF kötvényhozamon kamatozik a teljes időtávon át.</p>
        <p><strong>Eurós út:</strong> a kezdőösszeget a jelenlegi árfolyamon euróra váltjuk, az EUR kötvényhozamon kamatozik, majd a célárfolyamon visszaváltjuk forintra. A közbülső grafikonpontokhoz az árfolyamot mértani interpolációval becsüljük — az árfolyam egyenletesen halad a jelenlegi szintről a megadott célértékig.</p>
        <p><strong>Fedezeti árfolyam:</strong> az az EUR/HUF szint, amelyen mindkét út ugyanakkora végső forintértéket ad. Levezetése: <em>P × (1 + r<sub>HUF</sub>)<sup>n</sup> = (P / árfolyam<sub>most</sub>) × (1 + r<sub>EUR</sub>)<sup>n</sup> × árfolyam<sub>fedezeti</sub></em>, amiből: <em>árfolyam<sub>fedezeti</sub> = árfolyam<sub>most</sub> × (1 + r<sub>HUF</sub>)<sup>n</sup> / (1 + r<sub>EUR</sub>)<sup>n</sup></em>.</p>
        <p><strong>Reálértékek:</strong> mindkét utat a forint inflációjával korrigáljuk, mivel mindkettő forintban végződik. A kérdés ugyanaz: mennyit lehet ténylegesen vásárolni Magyarországon?</p>
        <p class="disclaimer">Az alapértelmezett értékek 2026. május körüli adatokon alapulnak. A forint kötvényhozam forrása a FixMÁP/MÁP+ (Államkincstár); az eurós kamat az EKB betéti rendelkezésre állás kamatláb (2,00%) és jellemző eurozónás megtakarítási számlák alapján; a forint infláció az MNB 2026-os előrejelzése (~3,2%); az EUR/HUF árfolyam: ~365 (2026. május); összehasonlításként: ~403 (2025. május), ~310 (2015). Az árfolyam-előrejelzések természetüknél fogva bizonytalanok — ez a kalkulátor forgatókönyv-elemző eszköz, nem jóslat. Nem minősül pénzügyi tanácsadásnak.</p>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function formatAmountDisplay(el) {
    const raw = parseFloat(el.value.replace(/\s/g, '').replace(',', '.'));
    if (!isNaN(raw) && raw >= 0) el.value = Math.round(raw).toLocaleString('hu-HU').replace(/,/g, ' ');
}
function unformatAmount(el) {
    el.value = el.value.replace(/\s/g, '');
}
function getAmount() {
    return parseFloat(document.getElementById('amount').value.replace(/\s/g, '').replace(',', '.'));
}

function fmtFull(value) {
    const rounded = Math.round(Math.abs(value));
    return rounded.toLocaleString('hu-HU').replace(/,/g, ' ') + ' Ft';
}

function fmtShort(value) {
    const abs = Math.abs(value);
    let s;
    if (abs >= 1e9)      s = (value / 1e9).toFixed(1) + ' Mrd Ft';
    else if (abs >= 1e6) s = (value / 1e6).toFixed(2) + ' M Ft';
    else if (abs >= 1e3) s = (value / 1e3).toFixed(1) + ' e Ft';
    else                 s = Math.round(value) + ' Ft';
    return s;
}

function fmtRate(r) {
    return r.toFixed(0) + ' Ft/€';
}

function pct(rate) {
    return (rate * 100).toFixed(1).replace('.', ',') + '%';
}

function recalculate() {
    if (document.getElementById('results').classList.contains('visible')) calculate();
}

let chartInstance = null;

function calculate() {
    const P        = getAmount();
    const rNow     = parseFloat(document.getElementById('rateNow').value);
    const rTarget  = parseFloat(document.getElementById('rateTarget').value);
    const rHuf     = parseFloat(document.getElementById('rateHuf').value) / 100;
    const rEur     = parseFloat(document.getElementById('rateEur').value) / 100;
    const iHuf     = parseFloat(document.getElementById('inflHuf').value) / 100;
    const n        = parseInt(document.getElementById('years').value);
    const showReal = document.getElementById('realToggle').checked;

    if ([P, rNow, rTarget, rHuf, rEur, iHuf, n].some(v => isNaN(v) || v < 0) || n < 1 || rNow <= 0) return;

    const pts = n + 1;

    // HUF path nominal
    const hufNom = Array.from({ length: pts }, (_, y) => P * Math.pow(1 + rHuf, y));

    // EUR path: geometric rate interpolation, value in HUF
    const eurNom = Array.from({ length: pts }, (_, y) => {
        const rateY = rNow * Math.pow(rTarget / rNow, y / n);
        return (P / rNow) * Math.pow(1 + rEur, y) * rateY;
    });

    // Real values: both deflated by HUF inflation — both paths end in HUF
    const hufReal = hufNom.map((v, y) => v / Math.pow(1 + iHuf, y));
    const eurReal = eurNom.map((v, y) => v / Math.pow(1 + iHuf, y));

    const fvHuf      = hufNom[n];
    const fvEur      = eurNom[n];
    const pvHuf      = hufReal[n];
    const pvEur      = eurReal[n];
    const nomDiff    = fvEur - fvHuf;
    const realDiff   = pvEur - pvHuf;

    // Breakeven: rateNow * (1+rHuf)^n / (1+rEur)^n
    const breakeven  = rNow * Math.pow(1 + rHuf, n) / Math.pow(1 + rEur, n);
    const annualFxNeeded = Math.pow(breakeven / rNow, 1 / n) - 1;

    // Breakeven box
    document.getElementById('be-rate').textContent = fmtRate(breakeven);
    const beSubText = `Az EUR úthoz az EUR/HUF-nak évi ${pct(annualFxNeeded)}-ot kell emelkednie. `
        + (rTarget >= breakeven
            ? `A te becslésed (${fmtRate(rTarget)}) e fölött van → az EUR út nyer.`
            : `A te becslésed (${fmtRate(rTarget)}) e alatt van → a HUF út nyer.`);
    document.getElementById('be-sub').textContent = beSubText;

    // Real rates
    const realHufRate    = Math.pow(1 + rHuf, 1) / Math.pow(1 + iHuf, 1) - 1;
    const fxDriftPerYear = Math.pow(rTarget / rNow, 1 / n);
    const realEurRateHuf = (1 + rEur) * fxDriftPerYear / (1 + iHuf) - 1;

    // Result cards
    if (showReal) {
        document.getElementById('val-huf').textContent  = fmtFull(pvHuf);
        document.getElementById('sub-huf').textContent  = 'mai vásárlóerőn';
        document.getElementById('real-huf').textContent = 'Reálkamat: ' + pct(realHufRate) + '/év  ·  nominális: ' + fmtFull(fvHuf);

        document.getElementById('val-eur').textContent  = fmtFull(pvEur);
        document.getElementById('sub-eur').textContent  = 'mai vásárlóerőn (HUF)';
        document.getElementById('real-eur').textContent = 'Reálkamat (árfolyammal): ' + pct(realEurRateHuf) + '/év  ·  nominális: ' + fmtFull(fvEur);

        document.getElementById('val-diff').textContent = (realDiff >= 0 ? '+' : '') + fmtFull(realDiff);
        document.getElementById('sub-diff').textContent = realDiff >= 0 ? 'Az EUR út vezet (reál)' : 'A HUF út vezet (reál)';
        document.getElementById('real-diff').textContent = 'Nominális: ' + (nomDiff >= 0 ? '+' : '') + fmtFull(nomDiff);
    } else {
        document.getElementById('val-huf').textContent  = fmtFull(fvHuf);
        document.getElementById('sub-huf').textContent  = 'nominális jövőérték';
        document.getElementById('real-huf').textContent = 'Reálérték: ' + fmtFull(pvHuf) + '  ·  reálkamat: ' + pct(realHufRate) + '/év';

        document.getElementById('val-eur').textContent  = fmtFull(fvEur);
        document.getElementById('sub-eur').textContent  = 'nominális jövőérték (HUF-ban)';
        document.getElementById('real-eur').textContent = 'Reálérték: ' + fmtFull(pvEur) + '  ·  reálkamat (árfolyammal): ' + pct(realEurRateHuf) + '/év';

        document.getElementById('val-diff').textContent = (nomDiff >= 0 ? '+' : '') + fmtFull(nomDiff);
        document.getElementById('sub-diff').textContent = nomDiff >= 0 ? 'Az EUR út vezet' : 'A HUF út vezet';
        document.getElementById('real-diff').textContent = 'Reál: ' + (realDiff >= 0 ? '+' : '') + fmtFull(realDiff);
    }

    // Diff card colour
    const diffCard = document.getElementById('card-diff');
    diffCard.className = 'result-card ' + ((showReal ? realDiff : nomDiff) >= 0 ? 'diff-pos' : 'diff-neg');

    // Chart
    const tc = getChartColors();
    const labels = Array.from({ length: pts }, (_, i) => i + '. év');
    document.getElementById('chart-title').textContent = showReal
        ? 'Reálérték az évek során (HUF, inflációval korrigálva)'
        : 'Nominális értékalakulás az évek során (HUF-ban)';

    const hufData = showReal ? hufReal : hufNom;
    const eurData = showReal ? eurReal : eurNom;

    const hufWinning = (eurData[n] < hufData[n]);

    if (chartInstance) chartInstance.destroy();
    chartInstance = new Chart(document.getElementById('chart').getContext('2d'), {
        type: 'line',
        data: {
            labels,
            datasets: [
                {
                    label: 'HUF kötvény',
                    data: hufData,
                    borderColor: '#f97316',
                    backgroundColor: 'transparent',
                    borderWidth: 2.5,
                    pointRadius: 0,
                    fill: false,
                    tension: 0.3,
                    order: hufWinning ? 1 : 2,
                },
                {
                    label: 'EUR kötvény (HUF-ban)',
                    data: eurData,
                    borderColor: '#7c3aed',
                    backgroundColor: hufWinning ? 'rgba(249,115,22,0.08)' : 'rgba(124,58,237,0.08)',
                    borderWidth: 2.5,
                    pointRadius: 0,
                    fill: { target: 0, above: 'rgba(124,58,237,0.08)', below: 'rgba(249,115,22,0.08)' },
                    tension: 0.3,
                    order: hufWinning ? 2 : 1,
                },
            ]
        },
        options: {
            responsive: true,
            aspectRatio: 2.2,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { position: 'top', labels: { boxWidth: 14, font: { size: 12 }, color: tc.legend } },
                tooltip: {
                    backgroundColor: tc.tooltipBg, titleColor: tc.tooltipText, bodyColor: tc.tooltipText,
                    borderColor: tc.tooltipBorder, borderWidth: 1,
                    callbacks: {
                        label: ctx => '  ' + ctx.dataset.label + ': ' + fmtFull(ctx.parsed.y),
                    }
                }
            },
            scales: {
                x: { grid: { color: tc.grid }, ticks: { maxTicksLimit: 10, font: { size: 11 }, color: tc.tick } },
                y: { grid: { color: tc.grid }, ticks: { font: { size: 11 }, color: tc.tick, callback: v => fmtShort(v) } }
            }
        }
    });

    document.getElementById('results').classList.add('visible');
}

window.addEventListener('load', () => calculate());
</script>
{% endblock %}
