{% extends "_base.html.jinja" %}
{% set lang = "en" %}
{% block title %}Personal Finance Toolkit{% endblock %}

{% block styles %}
        .hero { background: var(--white); padding: 4rem 1.5rem 3rem; border-bottom: 1px solid var(--border); }
        .hero .inner { max-width: 800px; margin: 0 auto; }
        .hero h1 { font-size: 2rem; font-weight: 700; margin-bottom: 0.75rem; }
        .hero p { color: var(--muted); font-size: 1.05rem; max-width: 520px; }

        .section { max-width: 800px; margin: 0 auto; padding: 2.5rem 1.5rem; }
        .section h2 { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 1rem; }

        .card-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        @media (max-width: 540px) { .card-grid { grid-template-columns: 1fr; } }

        .card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1.5rem;
            text-decoration: none;
            color: var(--text);
            display: block;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        .card:hover { border-color: var(--blue); box-shadow: 0 2px 8px rgba(37,99,235,0.1); }
        .card .tag {
            display: inline-block;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            margin-bottom: 0.75rem;
        }
        .tag-web { background: #eff6ff; color: var(--blue); }
        .tag-cli { background: #f0fdf4; color: #15803d; }
        .card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 0.35rem; }
        .card p { font-size: 0.9rem; color: var(--muted); }
        .card .arrow { display: inline-block; margin-top: 1rem; font-size: 0.875rem; color: var(--blue); font-weight: 500; }
{% endblock %}

{% block header %}
<header>
    <div class="inner">
        <a href="index.html" class="brand">Personal Finance Toolkit</a>
        <a href="https://github.com/mizsakpeti/personal-finance-toolkit">GitHub</a>
    </div>
</header>
{% endblock %}

{% block content %}
<div class="hero">
    <div class="inner">
        <h1>Personal Finance Toolkit</h1>
        <p>A collection of tools and calculators for making better, more informed personal finance decisions.</p>
    </div>
</div>

<div class="section">
    <h2>Web Calculators</h2>
    <div class="card-grid">
        <a href="calculators/cash-opportunity-cost/" class="card">
            <span class="tag tag-web">Calculator</span>
            <h3>The Hidden Cost of Saving</h3>
            <p>See what keeping too much money in a savings account is actually costing you over time.</p>
            <span class="arrow">Open calculator →</span>
        </a>
        <a href="calculators/currency-return/" class="card">
            <span class="tag tag-web">Calculator</span>
            <h3>HUF vs EUR Returns</h3>
            <p>Compare investing in HUF bonds vs EUR — find the exchange rate at which one path beats the other.</p>
            <span class="arrow">Open calculator →</span>
        </a>
        <a href="calculators/compound-growth/" class="card">
            <span class="tag tag-web">Calculator</span>
            <h3>Compound Growth &amp; Monthly SIP</h3>
            <p>Project how regular contributions compound over time. Compare bond/stock allocations, see the cost of fees, and find out what starting later really costs you.</p>
            <span class="arrow">Open calculator →</span>
        </a>
    </div>
</div>

<div class="section" style="padding-top: 0;">
    <h2>CLI Tools</h2>
    <div class="card-grid">
        <a href="https://github.com/mizsakpeti/personal-finance-toolkit/blob/main/docs/expense_categorizer.md" class="card">
            <span class="tag tag-cli">CLI</span>
            <h3>Expense Categorizer</h3>
            <p>Automatically categorize bank statement transactions from CSV or Excel files using keyword rules.</p>
            <span class="arrow">Read the docs →</span>
        </a>
    </div>
</div>
{% endblock %}

{% block footer %}
<footer>
    <a href="https://github.com/mizsakpeti/personal-finance-toolkit">Personal Finance Toolkit</a> · Not financial advice.
</footer>
{% endblock %}
