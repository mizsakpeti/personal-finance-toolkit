{% extends "_base.html.jinja" %}
{% set lang = "hu" %}
{% set root = "../" %}
{% block title %}Personal Finance Toolkit{% endblock %}

{% block styles %}
        .lang-switch { display: flex; align-items: center; gap: 0.3rem; font-size: 0.85rem; margin-left: auto; }
        .lang-switch a { color: var(--muted); text-decoration: none; padding: 0.2rem 0.4rem; border-radius: 4px; }
        .lang-switch a:hover { color: var(--text); background: var(--bg); }
        .lang-switch .current { font-weight: 700; color: var(--text); padding: 0.2rem 0.4rem; }
        .lang-switch .sep { color: var(--border); }

        .hero { background: var(--white); padding: 4rem 1.5rem 3rem; border-bottom: 1px solid var(--border); }
        .hero .inner { max-width: 800px; margin: 0 auto; }
        .hero h1 { font-size: 2rem; font-weight: 700; margin-bottom: 0.75rem; }
        .hero p { color: var(--muted); font-size: 1.05rem; max-width: 520px; }

        .section { max-width: 800px; margin: 0 auto; padding: 2.5rem 1.5rem; }
        .section h2 { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 1rem; }

        .card-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        @media (max-width: 540px) { .card-grid { grid-template-columns: 1fr; } }

        .card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1.5rem;
            text-decoration: none;
            color: var(--text);
            display: block;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        .card:hover { border-color: var(--blue); box-shadow: 0 2px 8px rgba(37,99,235,0.1); }
        .card .tag {
            display: inline-block;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            margin-bottom: 0.75rem;
        }
        .tag-web { background: #eff6ff; color: var(--blue); }
        .tag-cli { background: #f0fdf4; color: #15803d; }
        .card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 0.35rem; }
        .card p { font-size: 0.9rem; color: var(--muted); }
        .card .arrow { display: inline-block; margin-top: 1rem; font-size: 0.875rem; color: var(--blue); font-weight: 500; }
{% endblock %}

{% block header %}
<header>
    <div class="inner">
        <a href="index.html" class="brand">Personal Finance Toolkit</a>
        <a href="https://github.com/mizsakpeti/personal-finance-toolkit">GitHub</a>
        <div class="lang-switch">
            <a href="../">EN</a>
            <span class="sep">|</span>
            <span class="current">HU</span>
        </div>
    </div>
</header>
{% endblock %}

{% block content %}
<div class="hero">
    <div class="inner">
        <h1>Personal Finance Toolkit</h1>
        <p>Eszközök és kalkulátorok gyűjteménye, amelyek segítenek jobb és megalapozottabb pénzügyi döntéseket hozni.</p>
    </div>
</div>

<div class="section">
    <h2>Webes kalkulátorok</h2>
    <div class="card-grid">
        <a href="../calculators/cash-opportunity-cost/hu/" class="card">
            <span class="tag tag-web">Kalkulátor</span>
            <h3>A bankszámlán parkoló pénz rejtett költsége</h3>
            <p>Számold ki, mennyibe kerül valójában, ha túl sok pénzt tartasz a bankszámládon.</p>
            <span class="arrow">Kalkulátor megnyitása →</span>
        </a>
        <a href="../calculators/currency-return/hu/" class="card">
            <span class="tag tag-web">Kalkulátor</span>
            <h3>HUF vagy EUR — Hol dolgozzon a megtakarításod?</h3>
            <p>Hasonlítsd össze a forint kötvény és az eurós befektetés hozamát — keresd meg azt az árfolyamot, ahol az egyik jobban megéri.</p>
            <span class="arrow">Kalkulátor megnyitása →</span>
        </a>
        <a href="../calculators/compound-growth/hu/" class="card">
            <span class="tag tag-web">Kalkulátor</span>
            <h3>A vagyon két tényezője: az idő és a rendszeresség</h3>
            <p>Nézd meg, hogyan nő a rendszeres befizetés kamatos kamattal. Hasonlíts össze kötvény/részvény arányokat, lásd a díjak hatását, és tudd meg, mit jelent a késlekedés.</p>
            <span class="arrow">Kalkulátor megnyitása →</span>
        </a>
    </div>
</div>

<div class="section" style="padding-top: 0;">
    <h2>Parancssori eszközök</h2>
    <div class="card-grid">
        <a href="https://github.com/mizsakpeti/personal-finance-toolkit/blob/main/docs/expense_categorizer.md" class="card">
            <span class="tag tag-cli">CLI</span>
            <h3>Kiadás-kategorizáló</h3>
            <p>Bankszámlakivonatok tranzakcióinak automatikus kategorizálása CSV vagy Excel fájlokból, kulcsszó-szabályok alapján.</p>
            <span class="arrow">Dokumentáció →</span>
        </a>
    </div>
</div>
{% endblock %}

{% block footer %}
<footer>
    <a href="https://github.com/mizsakpeti/personal-finance-toolkit">Personal Finance Toolkit</a> · Nem minősül pénzügyi tanácsadásnak.
</footer>
{% endblock %}
